#version 330

uniform sampler2D colorTexture;

struct Luz {
    vec4 pos;
    vec4 color;
    float Ia, Id, Is;
    bool activa;
};

struct Material {
    float ka, kd, ks;
    bool usaTextura;
    vec4 color;
    int shiny;
    float alpha;
};

struct Camara {
    vec4 posicion;
};

uniform Luz luz;
uniform Luz luzExtra;
uniform Material material;
uniform Camara camara;

in vec4 fColor;
in vec4 fPos;
in vec4 fNormal;
in vec4 fTextureCoords;

out vec4 FragColor;

vec3 aplicarLuz(Luz l, vec4 colorBase) {
    if (!l.activa) {
        return vec3(0.0);
    }

    vec3 N = normalize(fNormal.xyz);
    vec3 L = normalize(l.pos.xyz - fPos.xyz);
    vec3 V = normalize(camara.posicion.xyz - fPos.xyz);
    vec3 R = reflect(-L, N);

    float ambiental = l.Ia * material.ka;
    float difusa = l.Id * material.kd * max(dot(N, L), 0.0);
    float especular = l.Is * material.ks * pow(max(dot(R, V), 0.0), float(max(material.shiny, 1)));

    vec3 luzColor = l.color.rgb;
    return colorBase.rgb * luzColor * (ambiental + difusa) + luzColor * especular;
}

void main() {
    vec4 colorBase = material.usaTextura
        ? texture(colorTexture, fTextureCoords.xy)
        : material.color * fColor;

    vec3 colorIluminado = colorBase.rgb;
    vec3 luzPrincipal = aplicarLuz(luz, colorBase);
    vec3 luzColorExtra = aplicarLuz(luzExtra, colorBase);
    colorIluminado = max(colorIluminado * 0.18, luzPrincipal + luzColorExtra);

    FragColor = vec4(colorIluminado, material.alpha * colorBase.a);
}
